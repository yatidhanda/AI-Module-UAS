# The Part A corpus and generated dataset builds belong under GARUDA_DATA_ROOT
# (~/GarudaEdgeData by default), never inside this checkout. These rules are a
# final guard if that root is accidentally pointed here.
GarudaEdgeData/
workspaces/*/corpus/
workspaces/*/quarantine/
workspaces/*/annotation/
workspaces/*/metadata.sqlite3*
datasets/*/
*.part
